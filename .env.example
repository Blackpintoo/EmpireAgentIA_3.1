# ============================================================
# CONFIGURATION EMPIRE AGENT IA v3
# ============================================================
# Copier ce fichier en .env et remplir avec vos vraies valeurs
# IMPORTANT : Ne JAMAIS commit le fichier .env dans git !

# ============================================================
# LOGGING
# ============================================================
EMPIRE_LOG_FILE=logs/empire_agent.log
EMPIRE_CONSOLE=1
EMPIRE_LOG_LEVEL=INFO

# ============================================================
# META TRADER 5 (OBLIGATOIRE)
# ============================================================
MT5_ACCOUNT=votre_numero_de_compte
MT5_PASSWORD=votre_mot_de_passe
MT5_SERVER=VantageInternational-Demo

# Mode dry-run (simulation sans exécution réelle)
# 0 = Trading réel, 1 = Simulation
MT5_DRY_RUN=0

# ============================================================
# TELEGRAM (OBLIGATOIRE)
# ============================================================
# Créer un bot via @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=votre_bot_token
TELEGRAM_CHAT_ID=votre_chat_id

# ============================================================
# API EXTERNES (Phase 5) - Toutes GRATUITES
# ============================================================

# --- Finnhub : Calendrier économique ---
# Inscription : https://finnhub.io/register (GRATUIT - 60 appels/min)
# Usage : Détection événements HIGH impact (FOMC, NFP, CPI, GDP, etc.)
FINNHUB_API_KEY=votre_finnhub_api_key

# --- Alpha Vantage : News Sentiment ---
# Inscription : https://www.alphavantage.co/support/#api-key (GRATUIT - 25 appels/jour)
# Usage : Sentiment des news pour confirmation des signaux
ALPHA_VANTAGE_API_KEY=votre_alpha_vantage_api_key

# --- Fear & Greed Index : Sentiment Crypto ---
# PAS D'API KEY REQUISE (API publique gratuite)
# API : https://api.alternative.me/fng/
# Usage : Contexte sentiment global crypto (contrarian trading)

# ============================================================
# NOTES
# ============================================================
# 1. MT5_ACCOUNT, MT5_PASSWORD, MT5_SERVER sont OBLIGATOIRES
# 2. TELEGRAM_BOT_TOKEN et TELEGRAM_CHAT_ID sont OBLIGATOIRES
# 3. FINNHUB_API_KEY et ALPHA_VANTAGE_API_KEY sont recommandées
#    (sans elles, les agents news/sentiment/fundamental retourneront des valeurs neutres)
# 4. Toutes les API externes sont GRATUITES pour un usage personnel
# 5. Le système utilise un cache local pour économiser les appels :
#    - Finnhub : cache 1h
#    - Alpha Vantage : cache 30 min
#    - Fear & Greed : cache 1h
